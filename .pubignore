# Files excluded from the published package.
#
# A .pubignore replaces .gitignore entirely for publishing, so everything that
# should stay out of the archive has to be listed here — not just the extras.
#
# The build artifacts below are currently tracked in git (they predate this
# file), which is why pub would otherwise bundle them despite .gitignore.

# Dart / Flutter build artifacts
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
pubspec.lock

# Build outputs
build/

# IDE
.idea/
.vscode/
*.iml

# macOS
.DS_Store

# Coverage
coverage/

# Generated files
*.g.dart
*.freezed.dart

# Pub cache
.pub-cache/
.pub/

# Repo tooling that consumers do not need
CLAUDE.md
