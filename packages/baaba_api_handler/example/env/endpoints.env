# Endpoint templates for the example app.
#
# Named placeholders generate named parameters:
POST_COMMENTS=posts/{postId}/comments
PARTNER_STATEMENT=accounts/{account}/statements/{period}

# Positional {} placeholders — the form an envied .env file already uses —
# generate arg1, arg2, ...
USER_POST=users/{}/posts/{}

# No placeholders: a getter.
PARTNER_GRAPHQL=graphql
